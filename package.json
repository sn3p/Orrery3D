{
  "name": "Orrery3D",
  "version": "1.1.3",
  "description": "Historical source for the 3D asteroid visualization now maintained in Orrery",
  "main": "index.js",
  "repository": "git@github.com:sn3p/Orrery3D.git",
  "author": "Matthijs Kuiper <info@matthijskuiper.nl>",
  "license": "MIT",
  "scripts": {
    "benchmark": "node benchmarks/run.cjs",
    "benchmark:serve": "node benchmarks/server.cjs",
    "catalog:build": "node scripts/catalog.cjs build",
    "catalog:serve": "node scripts/serve-catalog.cjs",
    "catalog:benchmark": "node benchmarks/catalog-loading.cjs",
    "build": "node scripts/build.cjs",
    "deploy": "gh workflow run pages.yml --ref master",
    "watch": "node --watch-path=retirement/index.html scripts/build.cjs --output-clean",
    "serve": "npm run build -- --output-clean && node scripts/serve.cjs",
    "historical:watch": "webpack --config webpack.app.config.cjs --mode development --watch",
    "historical:serve": "webpack serve --config webpack.app.config.cjs --mode development --open",
    "test": "node --test tests/retirement.cjs tests/retirement-server.cjs && node tests/retirement-browser.cjs"
  },
  "dependencies": {
    "dat.gui": "^0.7.9",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "cssnano": "^9.0.4",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "1.63.0",
    "postcss-import": "^17.0.0",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.5.2",
    "tar": "^7.5.22",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
